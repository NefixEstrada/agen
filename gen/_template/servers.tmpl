{{ define "servers" }}
{{ template "header" $ }}

// serverConst is a constant server address from the AsyncAPI document.
type serverConst string

{{- range $s := $.Servers }}

{{ template "servers/server_doc" $s }}
const {{ $s.GoName }}Server serverConst = {{ $s.Host | quote }}
{{- end }}

// Build returns the server address.
func (s serverConst) Build() (string, error) {
	return string(s), nil
}

// MustBuild is like Build, but panics on error. It never errors for constant
// servers; it is kept for interface parity.
func (s serverConst) MustBuild() string {
	addr, err := s.Build()
	if err != nil {
		panic(err)
	}
	return addr
}

{{ end }}
