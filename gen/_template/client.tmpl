{{- define "client/publish_config" }}
// publishConfig carries options applied on top of a generated message.
type publishConfig struct {
	key     string
	headers map[string]string
}

// PublishOption customizes a single publish.
type PublishOption func(*publishConfig)

func newPublishConfig() *publishConfig {
	return &publishConfig{
		headers: map[string]string{},
	}
}

// WithKey sets the broker partition key of the published message.
func WithKey(key string) PublishOption {
	return func(c *publishConfig) {
		c.key = key
	}
}

// WithHeader sets an extra header on the published message.
func WithHeader(k, v string) PublishOption {
	return func(c *publishConfig) {
		c.headers[k] = v
	}
}
{{- end }}

