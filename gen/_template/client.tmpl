{{ template "client/publish_config" $ }}

// Client publishes messages of the application's `send` operations to a
// broker.
type Client struct {
	publisher broker.Publisher
}

// NewClient creates new Client defined by AAS, wiring the runtime publisher
// of the spec protocol.
//
// Pass WithPublisher to reuse an existing runtime Publisher instead.
func NewClient(addr string, opts ...ClientOption) (*Client, error) {
	cfg := newClientConfig(opts...)
	publisher := cfg.Publisher
	if publisher == nil {
{{- if $.BrokerWired }}
		p, err := redisruntime.NewPublisher(redisruntime.PublisherConfig{
			Addr: addr,
			Mode: cfg.Mode,
		})
		if err != nil {
			return nil, err
		}
		publisher = p
{{- else }}
		return nil, fmt.Errorf("agen: spec protocol %q has no runtime backend: construct a runtime publisher and pass it with WithPublisher", {{ $.BrokerProtocol | quote }})
{{- end }}
	}
	return &Client{
		publisher: publisher,
	}, nil
}

// Close closes the underlying publisher.
func (c *Client) Close(ctx context.Context) error {
	return c.publisher.Close(ctx)
}

