// Fake{{ $op.Name }}Handler captures {{ $op.Name }} messages; Err, when set, is
// returned by the handler.
type Fake{{ $op.Name }}Handler struct {
	mu      sync.Mutex
	Messages []{{ $op.ArgGo }}
	Err     error
}

var _ {{ $op.Name }}Handler = (*Fake{{ $op.Name }}Handler)(nil)

// {{ $op.Name }} implements {{ $op.Name }}Handler.
func (h *Fake{{ $op.Name }}Handler) {{ $op.Name }}(ctx context.Context, msg {{ $op.ArgGo }}) error {
	h.mu.Lock()
	defer h.mu.Unlock()
	if h.Err != nil {
		return h.Err
	}
	h.Messages = append(h.Messages, msg)
	return nil
}
