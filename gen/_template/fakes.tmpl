// FakePublisher is a broker.Publisher that captures outgoing messages in
// memory; use it to unit-test publishing code without a broker.
type FakePublisher struct {
	mu       sync.Mutex
	Messages []broker.Outgoing
	Err      error // returned by Publish when set
}

var _ broker.Publisher = (*FakePublisher)(nil)

// Publish implements broker.Publisher.
func (p *FakePublisher) Publish(ctx context.Context, out broker.Outgoing) error {
	p.mu.Lock()
	defer p.mu.Unlock()
	if p.Err != nil {
		return p.Err
	}
	p.Messages = append(p.Messages, out)
	return nil
}

// Close implements broker.Publisher.
func (p *FakePublisher) Close(ctx context.Context) error { return nil }

// Reset drops captured messages.
func (p *FakePublisher) Reset() {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.Messages = nil
}

